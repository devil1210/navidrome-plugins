# ==============================================================================
# Configuración del Notificador de Álbumes Faltantes de ListenBrainz (MediaHuman)
# ==============================================================================

# Dirección y credenciales de Navidrome (API Subsonic)
# Ejemplo local o remoto: http://localhost:4533
NAVIDROME_URL=http://localhost:4533
NAVIDROME_USER=admin
NAVIDROME_PASSWORD=tu_password_aqui

# Telegram Bot API
# Crea un bot con @BotFather en Telegram para obtener el token
TELEGRAM_BOT_TOKEN=123456789:ABCDEF...
# Tu ID de chat o de canal (puedes obtenerlo con @userinfobot)
# Soporta múltiples IDs separados por comas y temas opcionales (ej. 123456789,-1001234567890:104674)
TELEGRAM_CHAT_ID=123456789
# Opcional: ID de tema/hilo en supergrupos con foros (dejar vacío si no aplica)
TELEGRAM_THREAD_ID=

# Estilo de cita para MediaHuman en Telegram:
# "blockquote" -> Usa <blockquote expandable> (recomendado)
# "code"       -> Usa bloque de código monoespaciado <pre><code>
TELEGRAM_QUOTE_STYLE=blockquote

# Filtro de Playlists a vigilar (separadas por comas)
# Las playlists creadas por el plugin suelen llamarse "daily-jams" o "Daily Jams"
PLAYLIST_NAMES=Daily Jams,daily-jams,Descubrimiento de la Semana,Descubrimiento Diario,weekly-jams

# ListenBrainz (enriquecimiento con artistas oficiales para playlists tipo Jams)
LISTENBRAINZ_USERNAME=tu_usuario_listenbrainz
LISTENBRAINZ_TOKEN=tu_token_listenbrainz

# Si no encuentra el álbum completo oficial en YouTube Music, ¿enviar el enlace del track/single?
FALLBACK_TO_TRACK=true

# Intervalo en minutos cuando se ejecuta en modo daemon (--daemon)
DAEMON_INTERVAL_MINUTES=30

# Límite de álbumes por lote entregados por sincronización (default: 20, 0 = sin límite)
MAX_ALBUMS_PER_SYNC=20

# Motor de Descarga Directa (/download)
# Carpeta de destino de descargas (por defecto: /media/downloads/music)
DOWNLOAD_MUSIC_DIR=/media/downloads/music
# Propietario UID:GID para los archivos descargados (default: 1000:1000 / devil:devil)
DOWNLOAD_UID=1000
DOWNLOAD_GID=1000
# Ruta opcional a archivo cookies.txt de YouTube para evitar verificaciones de bot
YTDL_COOKIES_PATH=

